# URL вашего задеплоенного приложения (Railway выдаёт автоматически)
WEBAPP_URL=https://your-app.railway.app

# SQLite: путь к файлу базы данных
DATABASE_URL=file:./dev.db

# Порт сервера (Railway выставляет автоматически)
PORT=3000
